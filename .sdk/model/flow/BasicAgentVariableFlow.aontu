# BasicAgentVariableFlow

main: kit: flow: BasicAgentVariableFlow:
{
  entity: "agent_variable",
  kind: "basic",
  name: "BasicAgentVariableFlow",
  step: [
    {
      i: {
        ref: "agent_variable_ref01"
      }

      m: {
        project_id: "project01"
      }

      o: "create"
    }

    {
      m: {
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "agent_variable_ref01"
          }
        }
      ]
    }

    {
      d: {
        project_id: "project01"
      }

      i: {
        ref: "agent_variable_ref01",
        srcdatavar: "agent_variable_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_variable_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "agent_variable_ref01",
        srcdatavar: "agent_variable_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "agent_variable01",
        project_id: "project01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_variable_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "agent_variable_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "agent_variable01",
        project_id: "project01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "agent_variable_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentVariableFlow"
}