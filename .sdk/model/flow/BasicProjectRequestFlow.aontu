# BasicProjectRequestFlow

main: kit: flow: BasicProjectRequestFlow:
{
  entity: "project_request",
  kind: "basic",
  name: "BasicProjectRequestFlow",
  step: [
    {
      m: {
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "project_request_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "project_request_ref01",
        srcdatavar: "project_request_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "project_request01",
        project_id: "project01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-project_request_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProjectRequestFlow"
}