# Local config / secrets
*.local.*
*.local

# Dependencies (no trailing slash: also ignores node_modules SYMLINKS, e.g.
# ts/node_modules -> shared tree, which a dir-only rule leaves tracked)
node_modules

# Python environments and build artifacts
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
dist-test/
*.tsbuildinfo
coverage.xml
.coverage

# Logs
*.log
logs/

# OS
.DS_Store

# Editor
*~
*.swp
